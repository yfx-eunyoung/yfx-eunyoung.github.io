      <g transform="translate(220 760)"><path transform="scale(0.8) rotate(-20)" vector-effect="non-scaling-stroke" d="M100,0 C100,45 60,95 5,98 C-50,101 -105,60 -100,5 C-95,-50 -55,-92 0,-100 C55,-108 100,-55 100,0 Z"></path><path transform="scale(1.4) rotate(-12)" vector-effect="non-scaling-stroke" d="M100,0 C100,45 60,95 5,98 C-50,101 -105,60 -100,5 C-95,-50 -55,-92 0,-100 C55,-108 100,-55 100,0 Z"></path><path transform="scale(2.1) rotate(-3)" vector-effect="non-scaling-stroke" d="M100,0 C100,45 60,95 5,98 C-50,101 -105,60 -100,5 C-95,-50 -55,-92 0,-100 C55,-108 100,-55 100,0 Z"></path></g>
