---
layout: layouts/base.njk
eleventyExcludeFromCollections: true
---
{#- Homepage. Lists below are generated from src/notes, src/rnd and src/resources (newest first). -#}
{%- macro numOf(p) -%}{{ p.data.version if p.data.kind == "resources" else p.data.num }}{%- endmacro -%}
{%- set latest = [] -%}
{%- for key in ["rnd", "notes", "resources"] %}{% if collections[key][0] %}{% set latest = (latest.push(collections[key][0]), latest) %}{% endif %}{% endfor -%}
{#- newest of each section, newest first -#}
{%- set latest = latest | newestFirst -%}
{%- set boardKinds = ["notes", "rnd", "resources"] -%}
{#- R&D card art: the post's illustrated preview (src/_includes/previews/rnd/<preview>.svg), else its pattern -#}
{%- macro rndArt(p) -%}
{%- if p.data.preview -%}<span class="rnd-pv">{% include "previews/rnd/" + p.data.preview + ".svg" %}<span class="pv-badge">{{ p.data.num }} · PREVIEW</span></span>
{%- else -%}<span class="card-art {{ p.data.art or 'pat-a' }}"></span>{%- endif -%}
{%- endmacro -%}
<!-- HERO: multi-layer parallax + mouse 3D -->
<section class="hero" id="top" data-hero>
  <span id="m-top" class="sr-only"></span>
  <div class="layer l-grid" aria-hidden="true"></div>
  <div class="layer l-far" aria-hidden="true">
    <svg class="d-only" viewBox="0 0 1440 860" preserveAspectRatio="xMidYMid slice" fill="none" stroke="var(--line-2)" stroke-width="1">
