<script type="application/json" id="feed-data">[
{%- for p in latest %}{% set k = kinds[p.data.kind] %}
{{ {title: p.data.title, body: p.data.summary, tag: (p.data.topics | tagline) + ((" · " + p.data.version) if p.data.kind == "resources" else ""), date: (p.date | isoDate), href: p.url, path: p.data.kind + "/" + p.fileSlug, code: p | codeLabel, chip: k.chip, pat: (p.data.art or k.art), kindLabel: k.feedLabel} | toJson | safe }}{% if not loop.last %},{% endif %}
