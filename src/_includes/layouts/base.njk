{%- set isHome = page.url == "/" -%}
{%- set section = kinds[kind or listKind].url if (kind or listKind) else "" -%}
{%- set pageTitle = (title + " — " + site.title) if title else (site.title + " — " + site.tagline) -%}
{%- set pageDesc = summary or description or site.description -%}
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="theme-color" content="#0D0E0B">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
<meta property="og:type" content="{{ 'article' if kind else 'website' }}">
<link rel="canonical" href="{{ page.url | absUrl }}">
<link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
<link rel="icon" href="/icons/favicon-32.png?v=2" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<link rel="manifest" href="/site.webmanifest?v=2">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
<script>try{var t=localStorage.getItem('yfx-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap">
<link rel="stylesheet" href="/assets/styles.css?v={{ build.v }}">
{%- if not isHome %}
<link rel="stylesheet" href="/assets/pages.css?v={{ build.v }}">
<script src="/assets/pages.js?v={{ build.v }}" defer></script>
{%- endif %}
<script src="/assets/main.js?v={{ build.v }}" defer></script>
</head>
<body>

<!-- NAV -->
<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="brand" title="KEY — Kim Eun Young" href="{{ '#top' if isHome else '/' }}"><svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><circle cx="9" cy="15" r="6.5" stroke="currentColor" stroke-width="1.8"></circle><circle cx="9" cy="15" r="2.2" fill="#FF6A2B"></circle><path d="M15.5 15H28.5M21 15v5.5M25.5 15v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg><span class="brand-word">YFX<span>Labs</span></span></a>
    <div class="nav-links">
      <a href="{{ '#glance' if isHome else '/notes/' }}"{% if section == '/notes/' %} aria-current="page"{% endif %}>FX Notes</a>
      <a href="{{ '#rnd' if isHome else '/rnd/' }}"{% if section == '/rnd/' %} aria-current="page"{% endif %}>R&amp;D</a>
      <a href="{{ '#tools' if isHome else '/resources/' }}"{% if section == '/resources/' %} aria-current="page"{% endif %}>Resources</a>
      <a href="{{ '#about' if isHome else '/#about' }}">About</a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme"><svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg><svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></button>
    </div>
    <div class="nav-mobile">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme"><svg class="ic-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg><svg class="ic-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></button>
      <button type="button" class="icon-btn" data-menu-open aria-label="Open menu" aria-controls="menu-sheet" aria-expanded="false"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h10"></path></svg></button>
    </div>
  </nav>
  <div class="nav-progress" aria-hidden="true"></div>
</header>

<main{% if not isHome %} class="page"{% endif %}>
{{ content | safe }}
</main>

