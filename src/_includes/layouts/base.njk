<!-- MOBILE MENU SHEET -->
<div class="sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="sheet-top">
    <span class="eyebrow" style="color:var(--ink-3)">MENU</span>
    <button type="button" class="icon-btn" data-menu-close aria-label="Close menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
  </div>
  <nav aria-label="Mobile">
    <a href="{{ '#m-glance' if isHome else '/notes/' }}" data-menu-link><span>FX Notes</span><span style="color:var(--ember)">N/</span></a>
    <a href="{{ '#m-rnd' if isHome else '/rnd/' }}" data-menu-link><span>R&amp;D</span><span style="color:var(--cool)">R/</span></a>
    <a href="{{ '#m-tools' if isHome else '/resources/' }}" data-menu-link><span>Resources</span><span style="color:var(--ink-2)">T/</span></a>
    <a href="{{ '#m-about' if isHome else '/#about' }}" data-menu-link><span>About</span><span style="color:var(--ink-2)">A/</span></a>
  </nav>
  <span class="sheet-foot">yfxlabs.dev · FX TD working notebook</span>
